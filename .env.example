# LandslideGuard — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# No API keys are required for core functionality.
#
# PLACEHOLDER values are shown as <your_value_here>.
# Leave optional entries blank if you do not use that service.

# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────
LANDSLIDEGUARD_ENV=development
LANDSLIDEGUARD_LOG_LEVEL=INFO
LANDSLIDEGUARD_SECRET_KEY=<your_secret_key_here>

# ─────────────────────────────────────────────
# WEATHER API (Open-Meteo — NO KEY REQUIRED)
# Open-Meteo is free and open-source.
# Leave OPENMETEO_API_KEY blank unless you have a commercial subscription.
# Commercial subscription API key: <your_openmeteo_api_key_here>
# ─────────────────────────────────────────────
OPENMETEO_API_KEY=

# ─────────────────────────────────────────────
# NASA EARTHDATA (optional — for Global Landslide Catalog download)
# Register at: https://urs.earthdata.nasa.gov/
# ─────────────────────────────────────────────
NASA_EARTHDATA_USERNAME=<your_earthdata_username>
NASA_EARTHDATA_PASSWORD=<your_earthdata_password>

# ─────────────────────────────────────────────
# ALERT NOTIFICATIONS (optional — disabled by default)
# ─────────────────────────────────────────────
# Email notifications (SMTP)
SMTP_HOST=<your_smtp_host>
SMTP_PORT=587
SMTP_USERNAME=<your_smtp_username>
SMTP_PASSWORD=<your_smtp_password>
ALERT_EMAIL_FROM=<your_email_from>
ALERT_EMAIL_TO=<your_email_to>

# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DATABASE_PATH=data/landslide_guard.db
